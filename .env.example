# ESPN league identity. Find the league ID in the URL when you're viewing your
# league: fantasy.espn.com/football/league?leagueId=XXXXXXX
LEAGUE_ID=
FIRST_SEASON=

# Private-league credentials. Get these from a browser where you're signed in to
# ESPN: DevTools -> Application -> Cookies -> https://www.espn.com
#   espn_s2  a long URL-encoded string
#   SWID     a GUID *including* its surrounding curly braces, e.g. {AAAA-BBBB-...}
# These stay on your machine. The ingest writes JSON into data/, and Netlify
# builds from that committed JSON, so the deploy never needs these secrets.
ESPN_S2=
SWID=
